{
  "name": "@steward/companion",
  "version": "0.1.0",
  "description": "Steward Local Companion: runs the official Codex CLI on your machine with your own login so Steward agents can use your ChatGPT plan without your credentials ever leaving your device.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronavkarumsi04/steward.git",
    "directory": "apps/companion"
  },
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": { "steward-companion": "./dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
