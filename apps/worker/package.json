{
  "name": "@steward/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@steward/agents": "workspace:*",
    "@steward/ai": "workspace:*",
    "@steward/browser": "workspace:*",
    "@steward/core": "workspace:*",
    "@steward/db": "workspace:*",
    "@steward/legal": "workspace:*",
    "@steward/sandbox": "workspace:*",
    "@steward/schema": "workspace:*",
    "@steward/tools": "workspace:*",
    "@steward/workflows": "workspace:*",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
