{
  "name": "@steward/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test/*": {
      "types": "./dist/test/*.d.ts",
      "default": "./dist/test/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@steward/ai": "workspace:*",
    "@steward/browser": "workspace:*",
    "@steward/crypto": "workspace:*",
    "@steward/db": "workspace:*",
    "@steward/integrations": "workspace:*",
    "@steward/policy": "workspace:*",
    "@steward/schema": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@steward/legal": "workspace:*",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
