{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "env": ["NODE_ENV", "API_URL", "API_INTERNAL_URL", "NEXT_PUBLIC_API_URL", "EMBEDDED_API", "APP_URL", "PUBLIC_API_URL", "VERCEL", "VERCEL_PROJECT_PRODUCTION_URL"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true }
  }
}
