# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=4000
# Extra browser origins allowed to call the API with credentials (APP_URL is always allowed).
CORS_ORIGINS=
# Set to true when the API runs behind a reverse proxy (Caddy, Vercel, a load balancer) so
# rate limits and audit logs use the client IP from X-Forwarded-For.
TRUST_PROXY=false

# ---- Database / infra ----
POSTGRES_USER=steward
POSTGRES_PASSWORD=steward
POSTGRES_DB=steward
DATABASE_URL=postgres://steward:steward@localhost:5432/steward
# Connections per process. Serverless instances each hold their own pool, so keep this small there.
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
# Local dev: 127.0.0.1, not `localhost` (localhost can resolve ::1 first and break gRPC).
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=steward-main
# Temporal Cloud: either an API key ...
# IMPORTANT: leave empty (no spaces/quotes) for a plaintext local Temporal. Any non-empty value —
# even whitespace — makes the Temporal client auto-enable TLS and fail against a local dev server.
TEMPORAL_API_KEY=
# ... or mTLS client certificates.
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
TEMPORAL_TLS_CA_PATH=
# Set true when no Temporal endpoint is reachable. Run-creating endpoints answer 503 with a reason
# instead of waiting out a connect timeout, which matters on hosts that cold start per request.
TEMPORAL_DISABLED=false
# How long to wait for Temporal before serving without workflow support.
TEMPORAL_CONNECT_TIMEOUT_MS=10000
# Apply pending migrations on boot. Leave true for a long-running server; set false under serverless,
# where cold starts would race each other applying the same migration.
RUN_MIGRATIONS_ON_START=true

# ---- Hosted deployment in one project (docs/DEPLOY.md §2.1) ----
# Serve the API in-process from the Next app rather than proxying to a separate host. This is read at
# BUILD time because it selects the /api/v1/* rewrite, so changing it requires a redeploy.
EMBEDDED_API=false

# ---- Backend deploy profile (docker compose --profile backend) ----
# Host interface for Postgres/Redis/Temporal/API ports. Keep loopback; Caddy is the only public entrypoint.
BIND_ADDRESS=127.0.0.1
# Public hostname of the API; Caddy obtains a Let's Encrypt certificate for it.
API_DOMAIN=localhost
ACME_EMAIL=

# ---- Secrets (generate with: openssl rand -hex 32) ----
STEWARD_MASTER_KEY=
SESSION_SECRET=
# JSON map of previous master keys for rotation, e.g. {"1a2b3c4d":"<hex>"}
STEWARD_PREVIOUS_MASTER_KEYS=

# ---- Legal documents (see docs/compliance/README.md) ----
# These decide what the public /legal pages are allowed to claim. Leave blank and the documents state
# truthfully that no legal entity exists and route contact through the repository.
# The operator's legal entity, if one exists. Setting it changes the contracting party in the Terms.
LEGAL_ENTITY_NAME=
# Registered address, used for legal notices and CAN-SPAM's postal-address requirement when an entity exists.
LEGAL_ENTITY_ADDRESS=
# Mailbox for privacy, legal and abuse requests. Without it, contact routes to LEGAL_REPOSITORY_URL.
LEGAL_CONTACT_EMAIL=
# Governing law and venue for the Terms and the DPA.
LEGAL_GOVERNING_LAW=
LEGAL_VENUE=
# Region where production data is hosted, disclosed in the Privacy Policy and used for subprocessors.
LEGAL_HOSTING_REGION=
# Name of the managed Postgres provider. Left blank, the Subprocessors page reads the vendor from
# DATABASE_URL; set this only to correct or override that description.
LEGAL_DATABASE_PROVIDER=
# Extra subprocessors as "Name|Role|data,categories|Region" entries separated by semicolons.
LEGAL_ADDITIONAL_SUBPROCESSORS=
# Set to true only if the operator charges subscribers; billing terms are documented as not applicable until then.
LEGAL_BILLING_ENABLED=false
# Set to false only if the operator takes no EU/EEA data subjects (disables the SCC transfer terms).
LEGAL_INTERNATIONAL_TRANSFERS=true
LEGAL_REPOSITORY_URL=

# ---- Auth ----
# Public self-registration. When false: the very first account can still register (bootstraps the
# owner), after which only invited emails (via the emailed invitation link) can create accounts.
ALLOW_SIGNUP=true
# Optional Google sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional GitHub sign-in / GitHub App
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Email for the platform itself (invitations, password reset). ----
# NOTE: this is *our* transactional mail only. Marketing sent by agents goes through the customer's
# own connected provider and always carries a one-click unsubscribe link.
# console = development only: messages (including the one-time links) are written to the API log.
# resend  = production: set RESEND_API_KEY and a PLATFORM_EMAIL_FROM on a domain verified in Resend.
PLATFORM_EMAIL_PROVIDER=console
PLATFORM_EMAIL_FROM="Steward <no-reply@localhost>"
RESEND_API_KEY=

# ---- Sandbox ----
SANDBOX_PROVIDER=docker
SANDBOX_DOCKER_HOST=
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_NETWORK=egress
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=2
SANDBOX_RUNTIME=

# ---- Artifacts ----
ARTIFACT_DIR=./data/artifacts

# ---- Observability ----
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Optional default AI provider for demos (BYOK is done in the UI) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Fully local demo without any external AI credentials: run `node scripts/stub-ai-provider.mjs 4599`,
# then add a provider (type OpenAI) with baseUrl http://127.0.0.1:4599/v1 and secret stub-local-key.

# ---- Internal ----
# Shared secret between worker and API for /v1/internal/*. Defaults to an HMAC derived from STEWARD_MASTER_KEY.
STEWARD_INTERNAL_TOKEN=
# Base URL the worker/web use to reach the API inside a private network (defaults to API_URL)
API_INTERNAL_URL=
